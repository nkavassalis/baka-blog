website:
  title: "baka.jp"
  description: "Nick's blog."
  base_url: "https://baka.jp"
  subtitle: |
    <a href='https://root.wtf'>bio</a>
    <a href='https://photog.jp'>gallery</a>
    <a href='https://bsky.app/profile/nkavassalis.bsky.social'>social</a>
    <a href='mailto:nick@baka.jp'>email</a>
  footer: |
    (c) Nick Kavassalis <script>document.write(new Date().getFullYear())</script>
  posts_per_page: 10
  # Generate llms.txt (index) + llms-full.txt (full archive) + robots.txt so AI
  # assistants (ChatGPT, Gemini, ...) can browse and quote your posts. Default true.
  # Set false to skip the llms files; robots.txt is always written (open by default).
  llms_txt: true
  # Image used for social preview cards (og:image) when a post has no image of its own.
  # Path relative to the site root; posts with images automatically use their first image.
  share_image: "images/logo.png"
  related_posts_per_tag: 5
  # Optional: tags pinned as a nav bar at the top of every page, in this order.
  # Names must match tags used in posts (case/punctuation-insensitive).
  # A pinned tag with no posts yet still gets a tags/<slug>.html page.
  pinned_tags:
    - technology
    - photography
    - games
    - other
  base_url: https://baka.jp
  # Author shown on every article page: name, mailto link, and avatar icon.
  # author_avatar is the filename inside static/images (copied to dist/images).
  author: "Nick Kavassalis"
  author_email: "nick@baka.jp"
  author_avatar: "avatar.jpg"

aws:
  s3_bucket: "your-bucket-name"
  cloudfront_dist_id: "your-distribution-id"

editor:
  host: 127.0.0.1
  port: 5000

images:
  # Editor cap: each uploaded image is downscaled so its width is at
  # most max_width (aspect preserved, no height cap), saved as JPEG
  # at jpeg_quality with EXIF orientation applied and a small
  # unsharp mask after resize.
  max_width: 3000
  jpeg_quality: 80
